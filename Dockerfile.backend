FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 sakhi && useradd --uid 10001 --gid sakhi --shell /usr/sbin/nologin sakhi
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./backend/
COPY curriculum/ ./curriculum/
COPY scripts/ ./scripts/
RUN mkdir -p /app/data /app/chroma_db /app/backups && chown -R sakhi:sakhi /app
USER sakhi
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD curl -fsS http://localhost:8000/ready || exit 1
CMD ["sh", "-c", "python scripts/preflight.py && exec uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY:-2} --proxy-headers --forwarded-allow-ips='*'"]
