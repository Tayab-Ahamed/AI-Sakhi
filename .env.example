# Copy to .env. Never commit the completed .env file.

# ---- LLM ----
GROQ_API_KEY=replace-with-real-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=256

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SAKHI_JWT_SECRET=replace-with-at-least-32-random-bytes
SAKHI_SESSION_HOURS=24
SAKHI_ENV=production
SAKHI_ENABLE_DEMO_SEED=false
SAKHI_ENABLE_CSRF=true

# ---- Privacy policy (operator must choose before production AI use) ----
# unconfigured, guardian (linked parent), or school (same-school staff).
# Adult-role accounts acknowledge for themselves. No student self-approval.
SAKHI_AI_APPROVAL_MODE=unconfigured
SAKHI_PRIVACY_POLICY_VERSION=
# 0 disables retention planning. Positive days enable read-only previews only.
SAKHI_CHAT_RETENTION_DAYS=0

# ---- Networking ----
# Public HTTPS URLs in production. Separate multiple origins with commas.
ALLOWED_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- Retrieval ----
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_MAX_DISTANCE=0.72
RAG_CANDIDATE_MULTIPLIER=4
RAG_CATALOG_TTL_SECONDS=300
CHROMA_PATH=/app/chroma_db

# ---- Storage ----
DB_PATH=/app/data/sakhi.db

# ---- Limits ----
MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50

# ---- Observability ----
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
SAKHI_ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
